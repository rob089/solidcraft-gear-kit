      {
        "name": "timing-pulleys",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "x-solidcraft-icon": "icons/timing_pulleys.svg",
          "x-solidcraft-field-order": "declared",
          "properties": {
            "summary": {
              "title": "Result",
              "description": "Hover the fields for the diameters.",
              "type": "string",
              "maxLength": 200,
              "x-solidcraft-enabled-when": {
                "not": {
                  "all": []
                }
              },
              "default": "-"
            },
            "profile": {
              "title": "Belt profile",
              "description": "GT2: Gates' belt, in no standard. HTD: ISO 13050. T: DIN 7721. MXL, XL: ISO 5294.",
              "type": "string",
              "oneOf": [
                {
                  "const": "gt2-2",
                  "title": "GT2 2 mm"
                },
                {
                  "const": "gt2-3",
                  "title": "GT2 3 mm"
                },
                {
                  "const": "htd-3m",
                  "title": "HTD 3M"
                },
                {
                  "const": "htd-5m",
                  "title": "HTD 5M"
                },
                {
                  "const": "htd-8m",
                  "title": "HTD 8M"
                },
                {
                  "const": "t2.5",
                  "title": "T2.5"
                },
                {
                  "const": "t5",
                  "title": "T5"
                },
                {
                  "const": "t10",
                  "title": "T10"
                },
                {
                  "const": "mxl",
                  "title": "MXL"
                },
                {
                  "const": "xl",
                  "title": "XL"
                }
              ],
              "default": "gt2-2"
            },
            "face_width": {
              "title": "Width",
              "description": "Of the toothed part; the standard's minimum for each belt width is in the tooltip.",
              "type": "number",
              "minimum": 1,
              "maximum": 500,
              "unit": "mm",
              "default": 7
            },
            "groove_clearance": {
              "title": "Groove clearance",
              "description": "Widens every groove by this much, half on each side; 0 = as the standard. Printed pulleys: try 0.1 to 0.2.",
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "unit": "mm",
              "default": 0
            },
            "flanges": {
              "title": "Flanges",
              "description": "Discs on the pulley that keep the belt on.",
              "type": "string",
              "oneOf": [
                {
                  "const": "none",
                  "title": "None"
                },
                {
                  "const": "one",
                  "title": "One, below the teeth"
                },
                {
                  "const": "both",
                  "title": "Both sides"
                }
              ],
              "default": "both"
            },
            "flange_height": {
              "title": "Flange height (0=auto)",
              "description": "Above the outside diameter; 0 = the standard's minimum.",
              "type": "number",
              "minimum": 0,
              "maximum": 50,
              "unit": "mm",
              "x-solidcraft-visible-when": {
                "not": {
                  "field": "flanges",
                  "eq": "none"
                }
              },
              "default": 0
            },
            "flange_thickness": {
              "title": "Flange thickness",
              "type": "number",
              "minimum": 0.2,
              "maximum": 20,
              "unit": "mm",
              "x-solidcraft-visible-when": {
                "not": {
                  "field": "flanges",
                  "eq": "none"
                }
              },
              "default": 1
            },
            "create_1": {
              "title": "Create pulley 1",
              "description": "On the Z axis.",
              "type": "boolean",
              "default": true
            },
            "teeth_1": {
              "title": "Pulley 1 teeth",
              "type": "integer",
              "minimum": 8,
              "maximum": 250,
              "default": 20
            },
            "create_2": {
              "title": "Create pulley 2",
              "description": "On +X, at the centre distance the belt sets.",
              "type": "boolean",
              "default": true
            },
            "teeth_2": {
              "title": "Pulley 2 teeth",
              "type": "integer",
              "minimum": 8,
              "maximum": 250,
              "default": 40
            },
            "belt_teeth": {
              "title": "Belt teeth",
              "description": "Belt length in teeth (pitch length ÷ pitch); sets the centre distance.",
              "type": "integer",
              "minimum": 20,
              "maximum": 2000,
              "default": 100
            },
            "name": {
              "title": "Name",
              "description": "Prefix of the body names.",
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "default": "Pulley"
            },
            "replace": {
