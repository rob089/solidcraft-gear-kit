{
  "id": "gear-kit",
  "name": "Gear Kit",
  "version": "1.0.0",
  "min_host_version": "0.50.0",
  "updates": {
    "github": "rob089/solidcraft-gear-kit"
  },
  "capabilities": [
    "commands@0.2",
    "dialog@0.1",
    "storage@0.1",
    "forms@0.1"
  ],
  "runtime": {
    "module": "plugin.wasm",
    "entries": [
      {
        "name": "spur-gears",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "x-solidcraft-icon": "icons/spur_gears.svg",
          "x-solidcraft-field-order": "declared",
          "properties": {
            "summary": {
              "title": "Result",
              "description": "Hover the fields for the diameters.",
              "type": "string",
              "maxLength": 200,
              "x-solidcraft-enabled-when": {
                "not": {
                  "all": []
                }
              },
              "default": "-"
            },
            "mate": {
              "title": "Gear 2 type",
              "description": "Gear 1 meshes with an external gear, a ring gear or a rack.",
              "type": "string",
              "oneOf": [
                {
                  "const": "gear",
                  "title": "External gear",
                  "x-solidcraft-icon": "icons/mate_gear.svg"
                },
                {
                  "const": "ring",
                  "title": "Ring gear (internal)",
                  "x-solidcraft-icon": "icons/mate_ring.svg"
                },
                {
                  "const": "rack",
                  "title": "Rack",
                  "x-solidcraft-icon": "icons/mate_rack.svg"
                }
              ],
              "default": "gear"
            },
            "module": {
              "title": "Module",
              "description": "Normal module m.",
              "type": "number",
              "minimum": 0.2,
              "maximum": 50,
              "unit": "mm",
              "default": 2
            },
            "pressure_angle": {
              "title": "Pressure angle",
              "description": "Normal pressure angle.",
              "type": "number",
              "minimum": 10,
              "maximum": 35,
              "unit": "°",
              "default": 20
            },
            "helix_angle": {
              "title": "Helix angle",
              "description": "0 = spur (straight) teeth.",
              "type": "number",
              "minimum": 0,
              "maximum": 45,
              "unit": "°",
              "default": 0
            },
            "helix_hand": {
              "title": "Gear 1 helix hand",
              "description": "Gear 2 gets the hand that meshes.",
              "type": "string",
              "oneOf": [
                {
                  "const": "right",
                  "title": "Right"
                },
                {
                  "const": "left",
                  "title": "Left"
                }
              ],
              "x-solidcraft-visible-when": {
                "not": {
                  "field": "helix_angle",
                  "eq": 0
                }
              },
              "default": "right"
            },
            "herringbone": {
              "title": "Herringbone",
              "description": "Double helical teeth, no axial thrust.",
              "type": "boolean",
              "x-solidcraft-visible-when": {
                "all": [
                  {
                    "not": {
                      "field": "helix_angle",
                      "eq": 0
                    }
                  },
                  {
                    "not": {
                      "field": "mate",
                      "eq": "rack"
                    }
                  }
                ]
              },
              "default": false
            },
            "face_width": {
              "title": "Face width",
              "description": "Both gears.",
              "type": "number",
              "minimum": 0.5,
              "maximum": 2000,
              "unit": "mm",
              "default": 10
            },
            "backlash": {
              "title": "Backlash",
              "description": "Of the pair, taken half from each gear.",
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "unit": "mm",
              "default": 0
            },
            "create_1": {
              "title": "Create gear 1",
              "description": "On the Z axis; with a ring gear, the ring is.",
              "type": "boolean",
              "default": true
            },
            "teeth_1": {
              "title": "Gear 1 teeth",
              "description": "Below 17 (20°) the root is undercut as hobbed.",
              "type": "integer",
              "minimum": 4,
              "maximum": 200,
              "default": 18
            },
            "profile_shift_1": {
              "title": "Gear 1 profile shift",
              "description": "x1; positive: thicker teeth, larger tip.",
              "type": "number",
              "minimum": -1,
              "maximum": 1.5,
              "default": 0
            },
            "create_2": {
              "title": "Create gear 2",
              "description": "Placed in mesh with gear 1.",
              "type": "boolean",
              "default": true
            },
            "teeth_2": {
              "title": "Gear 2 teeth",
              "description": "Teeth of gear 2, the ring gear or the rack (its length in pitches).",
              "type": "integer",
              "minimum": 1,
              "maximum": 400,
              "default": 36
            },
            "profile_shift_2": {
              "title": "Gear 2 profile shift",
              "description": "x2; the centre distance follows. Ring gear: positive outward.",
              "type": "number",
              "minimum": -1,
              "maximum": 1.5,
              "x-solidcraft-visible-when": {
                "not": {
                  "field": "mate",
                  "eq": "rack"
                }
              },
              "default": 0
            },
            "rim_diameter": {
              "title": "Ring Ø (0=auto)",
              "description": "Outer diameter of the ring; 0 = root diameter + 6 modules.",
              "type": "number",
              "minimum": 0,
              "maximum": 5000,
              "unit": "mm",
              "x-solidcraft-visible-when": {
                "all": [
                  {
                    "field": "create_2",
                    "eq": true
                  },
                  {
                    "field": "mate",
                    "eq": "ring"
                  }
                ]
              },
              "default": 0
            },
            "rack_height": {
              "title": "Rack height (0=auto)",
              "description": "Back face to pitch line; 0 = 6 modules.",
              "type": "number",
              "minimum": 0,
              "maximum": 2000,
              "unit": "mm",
              "x-solidcraft-visible-when": {
                "all": [
                  {
                    "field": "create_2",
                    "eq": true
                  },
                  {
                    "field": "mate",
                    "eq": "rack"
                  }
                ]
              },
              "default": 0
            },
            "name": {
              "title": "Name",
              "description": "Prefix of the body names.",
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "default": "Gear"
            },
            "addendum": {
              "title": "Addendum coefficient",
              "description": "× module (standard 1).",
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.5,
              "default": 1
            },
            "dedendum": {
              "title": "Dedendum coefficient",
              "description": "× module (standard 1.25).",
              "type": "number",
              "minimum": 0.8,
              "maximum": 2,
              "default": 1.25
            },
            "root_fillet": {
              "title": "Root fillet coefficient",
              "description": "Cutter tip radius × module (DIN 867: 0.38); ring gears use 0.25.",
              "type": "number",
              "minimum": 0,
              "maximum": 0.6,
              "default": 0.38
            },
            "replace": {
              "title": "Replaces folder",
              "description": "Set by Edit Gears: the timeline folder of the gears this run replaces (0: new gears).",
              "type": "integer",
              "minimum": 0,
              "maximum": 2000000000,
              "x-solidcraft-enabled-when": {
                "not": {
                  "all": []
                }
              },
              "default": 0
            }
          }
        },
        "dialog_hook": true,
        "slots": [
          {
            "kind": "menu",
            "name": "Spur / Helical Gears"
          }
        ]
      },
      {
