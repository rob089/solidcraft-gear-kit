          }
        },
        "dialog_hook": true,
        "slots": [
          {
            "kind": "menu",
            "name": "Bevel Gears"
          }
        ]
      },
      {
        "name": "worm-gears",
        "effect": "edit",
        "input_schema": {
          "type": "object",
          "x-solidcraft-icon": "icons/worm_gears.svg",
          "x-solidcraft-field-order": "declared",
          "properties": {
            "summary": {
              "title": "Result",
              "description": "Hover the fields for the diameters.",
              "type": "string",
              "maxLength": 200,
              "x-solidcraft-enabled-when": {
                "not": {
                  "all": []
                }
              },
              "default": "-"
            },
            "module": {
              "title": "Module",
              "description": "Axial module of the worm.",
              "type": "number",
              "minimum": 0.3,
              "maximum": 30,
              "unit": "mm",
              "default": 2
            },
            "pressure_angle": {
              "title": "Pressure angle",
              "description": "Axial pressure angle of the worm.",
              "type": "number",
              "minimum": 10,
              "maximum": 35,
              "unit": "°",
              "default": 20
            },
            "helix_hand": {
              "title": "Hand",
              "description": "The wheel gets the same hand.",
              "type": "string",
              "oneOf": [
                {
                  "const": "right",
                  "title": "Right"
                },
                {
                  "const": "left",
                  "title": "Left"
                }
              ],
              "default": "right"
            },
            "backlash": {
              "title": "Backlash",
              "description": "Of the pair, taken half from each gear.",
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "unit": "mm",
              "default": 0
            },
            "create_1": {
              "title": "Create worm",
              "description": "Along Y beside the wheel, in mesh.",
              "type": "boolean",
              "default": true
            },
            "starts": {
              "title": "Worm starts",
              "description": "Ratio = wheel teeth / starts.",
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "default": 1
            },
            "worm_diameter": {
              "title": "Worm pitch diameter",
              "description": "d1, usually 8 to 16 modules.",
              "type": "number",
              "minimum": 2,
              "maximum": 1000,
              "unit": "mm",
              "default": 20
            },
            "worm_length": {
              "title": "Worm length",
              "type": "number",
              "minimum": 2,
              "maximum": 3000,
              "unit": "mm",
              "default": 40
            },
            "create_2": {
